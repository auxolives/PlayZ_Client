WindowWidgetClass DialogBox {
 visible 1
 clipchildren 0
 inheritalpha 0
 ignorepointer 1
 color 0 0 0 0
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 1000
 style Colorable
 {
  ImageWidgetClass Background {
   clipchildren 1
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   imageTexture "{6BCB267A268B56DC}PlayZ_Client/PlayZUI/gui/textures/Background_01.edds"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
   filter 1
  }
  PanelWidgetClass BackgroundOverlay {
   ignorepointer 1
   color 0 0 0 0.784
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
  ImageWidgetClass vignette {
   visible 1
   ignorepointer 1
   color 0 0 0 0.922
   position -0.981 4.84
   size 1.6 0.9
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   fixaspect outside
   imageTexture "{E6B3EF816E067499}Gui/textures/inventory_bgvignette.edds"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
   filter 0
   nocache 1
  }
  GridSpacerWidgetClass DialogBoxPanel {
   color 0 0 0 0
   position 0 0
   size 0.45 0.3
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   scaled 1
   style Colorable
   Padding 10
   Margin 10
   "Size To Content V" 1
   content_halign center
   Columns 1
   Rows 6
   {
    TextWidgetClass Caption {
     visible 1
     clipchildren 0
     position 0 0
     size 0.95 0.22
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     style Bold
     text "#layout_dialog_title"
     font "gui/fonts/sdf_MetronBook72"
     "text color" 1 1 1 1
     "exact text" 1
     "exact text size" 32
     "size to text v" 1
     "text halign" center
     "text valign" center
    }
    PanelWidgetClass MidFillerTop {
     ignorepointer 1
     size 1 10
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     priority 6
    }
    RichTextWidgetClass Text {
     clipchildren 1
     color 1 1 1 1
     position 0 0
     size 0.95 0.46
     halign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 10
     text "text"
     font "gui/fonts/sdf_MetronLight72"
     "bold text" 1
     "exact text" 1
     "exact text size" 20
     "size to text h" 0
     "size to text v" 1
     "text halign" center
     wrap 1
     "condense whitespace" 1
    }
    PanelWidgetClass MidFillerBottom {
     ignorepointer 1
     size 1 10
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     priority 11
    }
    PanelWidgetClass SeparatorPanel {
     visible 0
     ignorepointer 1
     size 1 1
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     priority 10
     style rover_sim_colorable
    }
    PanelWidgetClass ButtonRow {
     ignorepointer 1
     size 1 36
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     priority 15
     {
      ButtonWidgetClass bYes {
       visible 1
       clipchildren 0
       inheritalpha 0
       color 1 0 0 1
       position 0 0
       size 0.22 0.85
       halign left_ref
       valign bottom_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       style EmptyHighlight
       text "#message_dialog_yes"
       text_proportion 0.55
       font "gui/fonts/sdf_MetronBook24"
       {
        ImageWidgetClass XboxHintYes {
         visible 0
         ignorepointer 1
         size 21 21
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         image0 "set:ccgui_enforce image:XBoxA"
         mode blend
         "src alpha" 1
         filter 0
        }
       }
      }
      ButtonWidgetClass bOK {
       visible 1
       inheritalpha 0
       color 1 0 0 1
       position 0 0
       size 0.22 0.85
       halign center_ref
       valign bottom_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       style EmptyHighlight
       text "#message_dialog_ok"
       text_proportion 0.55
       font "gui/fonts/sdf_MetronBook24"
       {
        ImageWidgetClass XboxHintOk {
         visible 0
         ignorepointer 1
         size 21 21
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         image0 "set:ccgui_enforce image:XBoxA"
         mode blend
         "src alpha" 1
         filter 0
        }
       }
      }
      ButtonWidgetClass bCancel {
       visible 1
       clipchildren 0
       inheritalpha 0
       color 1 0 0 1
       position 0 0
       size 0.22 0.85
       halign center_ref
       valign bottom_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       style EmptyHighlight
       text "#dialog_cancel"
       text_proportion 0.55
       font "gui/fonts/sdf_MetronBook24"
       {
        ImageWidgetClass XboxHintCancel {
         visible 0
         ignorepointer 1
         size 21 21
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         image0 "set:ccgui_enforce image:XBoxY"
         mode blend
         "src alpha" 1
         filter 0
        }
       }
      }
      ButtonWidgetClass bNo {
       visible 1
       inheritalpha 0
       color 1 0 0 1
       position 0 0
       size 0.22 0.85
       halign right_ref
       valign bottom_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       style EmptyHighlight
       text "#message_dialog_no"
       text_proportion 0.55
       font "gui/fonts/sdf_MetronBook24"
       {
        ImageWidgetClass XboxHintNo {
         visible 0
         ignorepointer 1
         size 21 21
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         image0 "set:ccgui_enforce image:XBoxB"
         mode blend
         "src alpha" 1
         filter 0
        }
       }
      }
     }
    }
   }
  }
 }
}